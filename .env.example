# API keys read by utils/chat.py. The provider is chosen by model-name prefix
# in call_api()/call_thinking_api().

# DeepSeek (model name starts with "deepseek")
DEEPSEEK_API_KEY=FILL_YOUR_KEY

# Tongyi / Qwen (default route, e.g. "qwen3.5-plus")
TONGYI_API_KEY=FILL_YOUR_KEY

# Volcano Engine / Doubao-Seed (model name starts with "seed")
VOLCANO_API_KEY=FILL_YOUR_KEY

# OpenRouter (Gemini models, called as "google/{model}" via OpenRouter)
OPEN_ROUTE_API_KEY=FILL_YOUR_KEY
